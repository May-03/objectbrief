---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, authors } from "../lib/blog-data.js";
---

<BaseLayout
  title={`About - ${SITE.name}`}
  description={`About ${SITE.name}: practical sourcing intelligence for product buyers.`}
  canonical="/about"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "About" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">About</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">
        Practical sourcing intelligence for people who place the order.
      </h1>
    </header>

    <div class="prose-article mt-10">
      <p>
        {SITE.name} began as a folder of notes from years of buying product overseas &mdash; supplier vetting checklists, MOQ notes, certification files, and the occasional story of an order gone sideways. We started publishing it here because the advice we kept reusing deserves to be written down once, properly.
      </p>
      <p>
        The site is independent and reader-funded through affiliate links. We only recommend products and suppliers we would use ourselves, and every article that contains an affiliate link says so. There are no trackers, no pop-ups, and no sponsored placements.
      </p>
      <h2 id="what-we-publish">What we publish</h2>
      <p>
        Guides that walk through a sourcing process start to finish. Product reviews based on hands-on use. Comparisons that answer "which one should I buy" with actual numbers. And sourcing notes from the field about MOQs, materials, certifications, and the questions manufacturers really answer.
      </p>
      <h2 id="how-we-make-money">How this site is funded</h2>
      <p>
        When you click an affiliate link and make a purchase, we may earn a commission at no extra cost to you. That is the entire business model &mdash; no ads, no sponsored posts, no paywalled research. The disclosure policy is simple: if a link earns us money, the article says so.
      </p>
      <h2 id="who-we-are">Who we are</h2>
      <p>A small editorial team with backgrounds in procurement, packaging engineering, and product research, scattered across three time zones.</p>
    </div>

    <section class="mt-12 border-t border-border pt-10">
      <h2 class="font-serif text-2xl font-semibold">Contributors</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => (
            <a href={`/authors/${author.slug}`} class="group flex items-start gap-3">
              <img src={author.avatar} alt="" width="48" height="48" class="h-12 w-12 rounded-full" />
              <div>
                <div class="font-serif text-base font-semibold group-hover:text-primary">{author.name}</div>
                <div class="mt-1 text-sm text-muted-foreground">{author.bio}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>