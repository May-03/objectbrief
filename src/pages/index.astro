---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import Icon from "../components/Icon.astro";
import { SITE, categories, sortedPosts, starterGuides } from "../lib/blog-data.js";

const all = await sortedPosts();
const start = await starterGuides();
const startSlugs = new Set(start.map((post) => post.slug));
const latest = all.filter((post) => !startSlugs.has(post.slug)).slice(0, 6);
const categoryTiles = categories
  .map((category) => ({
    ...category,
    count: all.filter((post) => post.category === category.slug).length,
  }))
  .filter((category) => category.count > 0);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: `${SITE.url}/`,
    logo: `${SITE.url}/favicon.svg`,
  },
];
---

<BaseLayout
  title={`${SITE.name}: ${SITE.tagline}`}
  description={SITE.description}
  canonical="/"
  flushFooter
  jsonLd={jsonLd}
>
  <section class="home-hero border-b border-border/60">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">{SITE.name}</p>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl">
        {SITE.tagline}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        What fits, what to buy, and how to fix the small things that go wrong. Most guides open with the short answer.
      </p>

      <form action="/blog" method="get" role="search" class="home-search mt-8 flex max-w-xl items-center gap-2">
        <label for="home-search-input" class="sr-only">Search all guides</label>
        <Icon name="search" class="ml-3 h-4 w-4 shrink-0 text-muted-foreground" />
        <input
          id="home-search-input"
          name="q"
          type="search"
          placeholder="Search guides, e.g. shrink band size, fitted sheet, labeler"
          class="min-w-0 flex-1 border-0 bg-transparent py-3 text-base outline-none placeholder:text-muted-foreground"
        />
        <button type="submit" class="mr-1.5 rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90">
          Search
        </button>
      </form>

      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          categoryTiles.map((category) => (
            <li>
              <a href={`/categories/${category.slug}`} class="category-tile group block h-full rounded-xl border border-border bg-card p-5">
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="font-serif text-xl font-semibold group-hover:text-primary">{category.name}</h2>
                  <span class="text-xs tabular-nums text-muted-foreground">{category.count} articles</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{category.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    start.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 py-14">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="font-serif text-3xl font-semibold">Start here</h2>
          <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">All articles &rarr;</a>
        </div>
        <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {start.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )
  }

  <section class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="font-serif text-3xl font-semibold">Latest articles</h2>
        <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">Browse the archive &rarr;</a>
      </div>
      <div class="mt-8">
        {latest.map((post) => <PostCard post={post} variant="list" />)}
      </div>
    </div>
  </section>

  <section class="border-t border-border/60 bg-secondary/40">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-3">
      <div>
        <h2 class="font-serif text-lg font-semibold">Answers first</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Guides lead with what to do or buy, then show the working so you can check it.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-lg font-semibold">Links are labelled</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Product links are affiliate links, marked as sponsored in the page code and explained on our
          <a href="/affiliate-disclosure" class="underline underline-offset-2 hover:text-foreground">disclosure page</a>.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-lg font-semibold">Sources at the end</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Where a guide relies on manufacturer instructions or standards, the references are listed after the article.
        </p>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
