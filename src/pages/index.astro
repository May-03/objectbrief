---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import Icon from "../components/Icon.astro";
import {
  SITE,
  categories,
  featuredPost,
  sortedPosts,
  popularPosts,
  getAuthor,
  getCategory,
  formatDate,
} from "../lib/blog-data.js";

const featured = await featuredPost();
const featuredAuthor = getAuthor(featured.author);
const featuredCategory = getCategory(featured.category);
const latest = (await sortedPosts()).filter((post) => post.slug !== featured.slug);
const popular = await popularPosts();
---

<BaseLayout
  title={`${SITE.name} - Sourcing intelligence for product buyers`}
  description={SITE.description}
  canonical="/"
  flushFooter
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
  }}
>
  <!-- Featured: compact editorial hero, text left / image right -->
  <section class="border-b border-border/60">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:py-12">
      <div class="hero-grid grid gap-8 lg:grid-cols-[11fr_9fr] lg:gap-14">
        <div class="hero-a">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wider text-muted-foreground">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/5 px-2.5 py-0.5 font-medium text-primary">
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-primary" />
              Featured
            </span>
            {
              featuredCategory && (
                <a href={`/categories/${featuredCategory.slug}`} class="inline-flex min-h-9 items-center text-primary hover:underline">
                  {featuredCategory.name}
                </a>
              )
            }
            <span>&middot;</span>
            <time datetime={featured.date}>{formatDate(featured.date)}</time>
          </div>
          <h1 class="mt-4 max-w-xl font-serif text-3xl font-semibold leading-[1.08] sm:text-4xl lg:text-[2.75rem]">
            {featured.title}
          </h1>
          <p class="mt-4 max-w-xl text-base text-muted-foreground sm:text-lg">
            {featured.excerpt}
          </p>
        </div>
        <div class="hero-b">
          <a href={`/blog/${featured.slug}`} class="block" aria-label={`Read ${featured.title}`}>
            <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted">
              {
                featured.thumbnail && (
                  <Image
                    src={featured.thumbnail}
                    alt={featured.thumbnailAlt}
                    class="h-full w-full object-cover"
                    width={900}
                    widths={[480, 720, 900]}
                    sizes="(min-width: 1024px) 480px, (min-width: 640px) 50vw, 100vw"
                  />
                )
              }
            </div>
          </a>
          <div class="mt-3 flex items-center justify-between text-xs text-muted-foreground">
            <div class="flex items-center gap-3">
              {
                featuredAuthor && (
                  <a href={`/authors/${featuredAuthor.slug}`} class="inline-flex min-h-9 items-center hover:text-foreground">
                    {featuredAuthor.name}
                  </a>
                )
              }
              <span>&middot;</span>
              <span>{featured.readingTime} min read</span>
            </div>
            <span class="hidden sm:inline">{formatDate(featured.date)}</span>
          </div>
        </div>
        <div class="hero-c flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={`/blog/${featured.slug}`}
            class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline"
          >
            Read the guide <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
          <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground">
            Browse all guides <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/categories/sourcing" class="text-sm text-muted-foreground hover:text-foreground">
            Sourcing notes
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-areas: "a b" "c b";
        grid-template-rows: auto auto;
        align-items: start;
      }
      .hero-a { grid-area: a; }
      .hero-b { grid-area: b; }
      .hero-c { grid-area: c; }
    }
  </style>

  <!-- Latest guides -->
  <section class="mx-auto max-w-6xl px-5 py-14" data-home-latest>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold">Latest guides</h2>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-home-filter=""
          class="rounded-full border px-3 py-1 text-xs transition-colors border-foreground bg-foreground text-background"
        >
          All
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-home-filter={category.slug}
              class="rounded-full border px-3 py-1 text-xs transition-colors border-border text-muted-foreground hover:text-foreground"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>

    <div data-home-empty class="mt-12 rounded-md border border-dashed border-border py-16 text-center text-muted-foreground" hidden>
      Nothing here yet in this section.
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((post, index) => <PostCard post={post} hidden={index >= 6} />)}
    </div>

    <div class="mt-12 text-center">
      <a href="/blog" class="inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-muted">
        Browse the archive <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </section>

  <!-- Most helpful -->
  <section class="border-t border-border/60">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="font-serif text-2xl font-semibold">Most helpful</h2>
        <a href="/blog" class="text-xs text-muted-foreground hover:text-foreground">All guides &rarr;</a>
      </div>
      <div class="mt-6">
        {popular.slice(0, 4).map((post) => <PostCard post={post} variant="list" />)}
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<script>
  const latest = document.querySelector("[data-home-latest]");
  if (latest) {
    const buttons = [...latest.querySelectorAll("[data-home-filter]")];
    const cards = [...latest.querySelectorAll("[data-post-card]")];
    const empty = latest.querySelector("[data-home-empty]");
    const activeClasses = ["border-foreground", "bg-foreground", "text-background"];
    const inactiveClasses = ["border-border", "text-muted-foreground", "hover:text-foreground"];

    const setActive = (button, active) => {
      button.classList.toggle(activeClasses[0], active);
      button.classList.toggle(activeClasses[1], active);
      button.classList.toggle(activeClasses[2], active);
      inactiveClasses.forEach((className) => button.classList.toggle(className, !active));
    };

    const filterCards = (category) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = !category || card.dataset.category === category;
        const show = match && visible < 6;
        card.hidden = !show;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      buttons.forEach((button) => setActive(button, button.dataset.homeFilter === category));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => filterCards(button.dataset.homeFilter || ""));
    });
  }
</script>