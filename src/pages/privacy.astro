---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";
---

<BaseLayout
  title={`Privacy policy - ${SITE.name}`}
  description={`How ${SITE.name} handles data: Google Analytics 4 traffic measurement, the email newsletter, the contact address, and what we do not collect.`}
  canonical="/privacy"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Privacy policy" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Privacy</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">Privacy policy</h1>
    </header>

    <div class="prose-article mt-10">
      <p>
        {SITE.name} is a mostly static website. We measure traffic with Google Analytics 4, we send
        an email newsletter to people who ask for it, and we do not sell personal data. This page
        explains each of those in plain terms.
      </p>

      <h2 id="what-we-collect">What we collect</h2>
      <ul>
        <li>
          <strong>Traffic measurement.</strong> The site loads Google Analytics 4 (measurement ID
          G-2Z6CMQX6R2). It records which pages are viewed, approximate location, device and browser
          type, and how visitors arrive. Google Analytics sets cookies in your browser to do this. We
          use the reports to decide which guides to write and improve.
        </li>
        <li>
          <strong>Newsletter.</strong> If you subscribe, the email address you enter is sent to our
          email service provider (Benchmark Email) so we can send you the newsletter. Every email includes
          an unsubscribe link.
        </li>
        <li>
          <strong>Contact messages.</strong> If you email us, we keep that correspondence to reply to it.
          We do not add it to the newsletter list.
        </li>
        <li>
          <strong>Theme preference.</strong> If you switch between light and dark mode, the choice is saved
          in your browser's <em>localStorage</em> under the <code>theme</code> key. It never leaves your device.
        </li>
        <li>
          <strong>Server logs.</strong> Our hosting provider may keep standard logs (IP address, request time,
          requested page) for security and reliability.
        </li>
      </ul>

      <h2 id="what-we-dont-collect">What we do not do</h2>
      <p>
        We do not run advertising pixels and we do not sell or rent your data. We do not place display ads
        or sponsored posts on the site.
      </p>

      <h2 id="your-choices">Your choices</h2>
      <p>
        You can block or delete cookies in your browser settings, or use Google's opt-out browser add-on
        for Analytics. You can unsubscribe from the newsletter at any time with the link in any email. To ask
        about, correct or delete data we hold about you, write to{" "}
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
      </p>

      <h2 id="third-party-links">Third-party links</h2>
      <p>
        Articles contain affiliate links and references to external marketplaces such as Amazon and
        Alibaba. Those destinations have their own privacy policies, and we are not responsible for their
        practices. We do not pass your data to them: you choose to visit a linked site yourself. See our{" "}
        <a href="/affiliate-disclosure">affiliate disclosure</a> for how those links work.
      </p>

      <h2 id="changes">Changes to this policy</h2>
      <p>
        If the way we collect data changes, this page will be updated first. Last reviewed: November 2026.
      </p>
    </div>
  </div>
</BaseLayout>