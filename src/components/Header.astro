---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { navItems } from "../lib/nav.ts";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (to) => (to === "/" ? current === "/" : current === to || current.startsWith(`${to}/`));
const activeClass = "text-foreground";
const inactiveClass = "text-muted-foreground transition-colors hover:text-foreground";
const headerClass =
  "sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md";
const iconClass =
  "inline-flex h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";
---

<header class={headerClass}>
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <span aria-hidden="true" class="brand-mark"></span>
      <span class="font-serif text-xl font-semibold tracking-tight">{SITE.name}</span>
    </a>

    <nav class="ml-auto mr-4 hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
      {
        navItems.map((item) => {
          if ("children" in item) {
            const active = item.children.some((c) => isActive(c.to));
            return (
              <details class="nav-menu relative" data-nav-menu>
                <summary class={`nav-link flex cursor-pointer list-none items-center gap-1 text-[15px] font-medium ${active ? activeClass : inactiveClass}`}>
                  {item.label}
                  <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4"><path fill="currentColor" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
                </summary>
                <ul class="absolute right-0 top-full z-50 mt-3 w-56 rounded-lg border border-border bg-background p-2 shadow-lg">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.to} class={`block rounded-md px-3 py-2 text-sm hover:bg-muted hover:text-foreground ${isActive(c.to) ? "text-foreground" : "text-muted-foreground"}`} aria-current={isActive(c.to) ? "page" : undefined}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </details>
            );
          }
          const active = isActive(item.to);
          return (
            <a
              href={item.to}
              class={`nav-link text-[15px] font-medium ${active ? activeClass : inactiveClass}`}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-search-toggle
        aria-label="Search"
        aria-controls="site-search"
        aria-expanded="false"
        class={iconClass}
      >
        <Icon name="search" class="h-4 w-4" />
      </button>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        class={iconClass}
      >
        <span data-theme-icon="moon"><Icon name="moon" class="h-4 w-4" /></span>
        <span data-theme-icon="sun" hidden><Icon name="sun" class="h-4 w-4" /></span>
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class={`${iconClass} lg:hidden`}
      >
        <span data-menu-icon="menu"><Icon name="menu" class="h-4 w-4" /></span>
        <span data-menu-icon="x" hidden><Icon name="x" class="h-4 w-4" /></span>
      </button>
    </div>
  </div>

  <div id="site-search" data-search-panel class="border-t border-border/60 bg-background text-foreground" hidden>
    <form action="/blog" method="get" class="mx-auto max-w-6xl px-5 py-3">
      <input
        data-search-input
        name="q"
        aria-label="Search guides, comparisons, sourcing advice"
        placeholder="Search guides, comparisons, sourcing advice..."
        class="w-full border-0 bg-transparent py-2 font-serif text-lg outline-none placeholder:text-muted-foreground"
      />
    </form>
  </div>

  <div id="mobile-menu" data-menu-panel class="border-t border-border/60 bg-background text-foreground lg:hidden" hidden>
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-3" aria-label="Mobile navigation">
      {
        navItems.map((item) => {
          if ("children" in item) {
            return (
              <div class="py-1">
                <p class="px-2 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">{item.label}</p>
                {item.children.map((c) => (
                  <a href={c.to} class={`block rounded-md px-4 py-2 text-base hover:bg-muted hover:text-foreground ${isActive(c.to) ? "text-foreground" : "text-muted-foreground"}`} aria-current={isActive(c.to) ? "page" : undefined}>{c.label}</a>
                ))}
              </div>
            );
          }
          const active = isActive(item.to);
          return (
            <a
              href={item.to}
              class={`rounded-md px-2 py-2 text-base hover:bg-muted hover:text-foreground ${active ? "text-foreground" : "text-muted-foreground"}`}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const searchToggle = document.querySelector("[data-search-toggle]");
  const searchPanel = document.querySelector("[data-search-panel]");
  const searchInput = document.querySelector("[data-search-input]");
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const menuPanel = document.querySelector("[data-menu-panel]");
  const menuIcon = document.querySelector('[data-menu-icon="menu"]');
  const closeIcon = document.querySelector('[data-menu-icon="x"]');
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const moonIcon = document.querySelector('[data-theme-icon="moon"]');
  const sunIcon = document.querySelector('[data-theme-icon="sun"]');

  const setMenu = (open) => {
    menuPanel.hidden = !open;
    menuIcon.hidden = open;
    closeIcon.hidden = !open;
    menuToggle?.setAttribute("aria-expanded", String(open));
  };

  const setSearch = (open) => {
    searchPanel.hidden = !open;
    searchToggle?.setAttribute("aria-expanded", String(open));
    if (open) searchInput?.focus();
  };

  const setThemeIcon = () => {
    const dark = document.documentElement.classList.contains("dark");
    moonIcon.hidden = dark;
    sunIcon.hidden = !dark;
  };

  setThemeIcon();

  searchToggle?.addEventListener("click", () => {
    setSearch(searchPanel.hidden);
  });

  menuToggle?.addEventListener("click", () => setMenu(menuPanel.hidden));

  const navMenus = [...document.querySelectorAll("[data-nav-menu]")];

  document.addEventListener("click", (event) => {
    navMenus.forEach((menu) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    navMenus.forEach((menu) => {
      if (!menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });

    if (!searchPanel.hidden) {
      setSearch(false);
      searchToggle?.focus();
    }

    if (!menuPanel.hidden) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  themeToggle?.addEventListener("click", () => {
    const next = !document.documentElement.classList.contains("dark");
    document.documentElement.classList.toggle("dark", next);
    localStorage.setItem("theme", next ? "dark" : "light");
    setThemeIcon();
  });
</script>