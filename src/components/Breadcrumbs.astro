---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";

const { items = [] } = Astro.props;
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items
    .filter((item, index) => item.to || index === items.length - 1)
    .map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: new URL(item.to ?? Astro.url.pathname, SITE.url).toString(),
    })),
};
---

{items.length > 1 && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}

<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
  {
    items.map((item, index) => (
      <span class="flex items-center gap-1">
        {index > 0 && <Icon name="chevron-right" class="h-3 w-3" />}
        {item.to ? (
          <a href={item.to} class="hover:text-foreground">{item.label}</a>
        ) : (
          <span class="text-foreground">{item.label}</span>
        )}
      </span>
    ))
  }
</nav>
