---
// Accepts both prop shapes used across the site so every article's end CTA renders:
//   prompt / note / url / cta  — original form (used by the shrink-band cluster)
//   link / label               — shorthand (used by most later articles)
// Before this, whichever shape was not declared got silently dropped, leaving an
// empty paragraph and an anchor with no href.
interface Props {
  prompt?: string;
  note?: string;
  url?: string;
  cta?: string;
  link?: string;
  label?: string;
}

const { prompt, note, url, cta, link, label } = Astro.props;
const href = url || link || "";
const ctaText = cta || label || "Check current Alibaba offer";
const promptText = prompt || "";
---

{
  href && (
    <aside class="affiliate-end-cta mt-12 border-t border-border pt-5">
      {promptText && <p class="font-serif text-base font-medium">{promptText}</p>}
      {note && <p class="mt-1 text-sm text-muted-foreground">{note}</p>}
      <a
        href={href}
        target="_blank"
        rel="sponsored noopener noreferrer"
        data-placement="article-end"
        class="mt-2 inline-block text-sm text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
      >
        {ctaText} <span aria-hidden="true">&rarr;</span>
      </a>
    </aside>
  )
}
