---
interface Props {
  note?: string;
}

const { note } = Astro.props;
---

<p class="my-6 rounded-sm border border-border bg-muted/50 px-4 py-3 text-xs leading-relaxed text-muted-foreground">
  {note ?? "Disclosure: We may earn a commission if you purchase through links on this page, at no additional cost to you."}
</p>