---
interface Props {
  note?: string;
  amazon?: boolean;
}

const { note, amazon = false } = Astro.props;
---

<aside class="disclosure mb-8" aria-label="Affiliate disclosure">
  <p>
    <strong>Disclosure:</strong>
    {note ?? "This guide contains affiliate links. We may earn a commission if you buy through them, at no extra cost to you."}
    {amazon && " As an Amazon Associate we earn from qualifying purchases."}
    <a href="/affiliate-disclosure">How we pick products</a>.
  </p>
</aside>
