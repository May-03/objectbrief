---
interface Props {
  title?: string;
  items: string[];
}

const { title = "Before you order, check for", items } = Astro.props;
---

<div class="my-8 rounded-md border border-border bg-muted/40 p-5 sm:p-6">
  <h3 class="font-serif text-base font-semibold">{title}</h3>
  <ul class="mt-3 grid gap-1.5 text-sm text-foreground/90">
    {items.map((item) => (
      <li class="flex items-start gap-2.5">
        <span aria-hidden="true" class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-sm border border-primary/40 bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" class="h-2.5 w-2.5 text-primary"><path d="M2.5 6.5 5 9l4.5-6" /></svg>
        </span>
        {item}
      </li>
    ))}
  </ul>
</div>