---
interface Props {
  title: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  description?: string;
  bestFor?: string;
  features?: string[];
  supplier?: string;
  moq?: string;
  priceNote?: string;
  affiliateUrl: string;
  buttonText?: string;
}

const {
  title,
  label = "Recommended Option",
  image,
  imageAlt = "",
  description,
  bestFor,
  features = [],
  supplier,
  moq,
  priceNote,
  affiliateUrl,
  buttonText = "View on Alibaba",
} = Astro.props;

const hasMeta = Boolean(supplier || moq || priceNote);
---

<div class="my-8 overflow-hidden rounded-xl border border-border bg-popover shadow-sm">
  <div class="flex flex-col sm:flex-row">
    {
      image && (
        <div class="flex shrink-0 items-center justify-center border-b border-border bg-muted/40 p-3 sm:w-52 sm:border-b-0 sm:border-r">
          <img
            src={image}
            alt={imageAlt}
            width="440"
            height="330"
            loading="lazy"
            class="h-40 w-full rounded-lg object-contain sm:h-44"
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
      <span class="w-fit rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{label}</span>

      <h3 class="text-lg font-semibold leading-snug text-foreground sm:text-xl">{title}</h3>

      {description && <p class="text-[15px] leading-6 text-muted-foreground">{description}</p>}

      {
        bestFor && (
          <p class="text-[15px] leading-6 text-muted-foreground">
            <span class="font-medium text-foreground">Best for: </span>
            {bestFor}
          </p>
        )
      }

      {
        features.length > 0 && (
          <ul class="grid gap-1.5 text-sm leading-5 text-muted-foreground">
            {features.map((feature) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                {feature}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-auto space-y-3 border-t border-border pt-4">
        {
          hasMeta && (
            <dl class="grid gap-2 text-sm sm:grid-cols-3 sm:gap-3">
              {supplier && (
                <div>
                  <dt class="text-xs uppercase tracking-wider text-muted-foreground">Supplier</dt>
                  <dd class="text-foreground">{supplier}</dd>
                </div>
              )}
              {moq && (
                <div>
                  <dt class="text-xs uppercase tracking-wider text-muted-foreground">MOQ</dt>
                  <dd class="text-foreground">{moq}</dd>
                </div>
              )}
              {priceNote && (
                <div>
                  <dt class="text-xs uppercase tracking-wider text-muted-foreground">Price</dt>
                  <dd class="text-foreground">{priceNote}</dd>
                </div>
              )}
            </dl>
          )
        }

        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
          <span class="text-xs text-muted-foreground">Supplier listing · Verify current terms</span>
          <a
            href={affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
            data-placement="inline-card"
            class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold leading-5 text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            {buttonText}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M7 7h10v10" />
              <path d="M7 17 17 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
