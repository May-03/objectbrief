---
interface Props {
  title: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  description?: string;
  bestFor?: string;
  features?: string[];
  supplier?: string;
  moq?: string;
  priceNote?: string;
  affiliateUrl: string;
  buttonText?: string;
}

const {
  title,
  label = "Recommended Option",
  image,
  imageAlt = "",
  description,
  bestFor,
  features = [],
  supplier,
  moq,
  priceNote,
  affiliateUrl,
  buttonText = "View on Alibaba",
} = Astro.props;
---

<div class:list={[
  "my-8 overflow-hidden rounded-md border-2 border-card-border bg-card",
  image && "grid sm:grid-cols-[220px_1fr]",
]}>
  {
    image && (
      <div class="relative aspect-[4/3] bg-muted sm:aspect-auto sm:h-full">
        <img
          src={image}
          alt={imageAlt}
          width="440"
          height="330"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    )
  }
  <div class="p-5 sm:p-6">
    <div class="text-xs uppercase tracking-wider text-muted-foreground">{label}</div>
    <h3 class="mt-1 font-serif text-xl font-semibold">{title}</h3>
    {description && <p class="mt-2 text-sm text-muted-foreground">{description}</p>}

    {bestFor && (
      <p class="mt-3 text-sm">
        <span class="font-medium">Best for: </span>
        <span class="text-muted-foreground">{bestFor}</span>
      </p>
    )}

    {
      features.length > 0 && (
        <ul class="mt-3 grid gap-1 text-sm text-muted-foreground">
          {features.map((feature) => (
            <li class="flex items-start gap-2">
              <span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-primary" />
              {feature}
            </li>
          ))}
        </ul>
      )
    }

    <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
      {supplier && (
        <div>
          <dt class="text-xs uppercase tracking-wider text-muted-foreground">Supplier</dt>
          <dd>{supplier}</dd>
        </div>
      )}
      {moq && (
        <div class:list={[supplier && "col-span-1", !supplier && "col-span-2"]}>
          <dt class="text-xs uppercase tracking-wider text-muted-foreground">MOQ</dt>
          <dd>{moq}</dd>
        </div>
      )}
      {priceNote && (
        <div class="col-span-2">
          <dt class="text-xs uppercase tracking-wider text-muted-foreground">Price</dt>
          <dd>{priceNote}</dd>
        </div>
      )}
    </dl>

    <a
      href={affiliateUrl}
      target="_blank"
      rel="sponsored noopener noreferrer"
      data-placement="inline-card"
      class="mt-4 inline-flex items-center gap-1.5 border-b border-primary pb-0.5 text-sm font-medium text-primary hover:border-primary/50 hover:text-primary/80"
    >
      {buttonText} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>