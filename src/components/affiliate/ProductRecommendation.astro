---
import { WHITE_BACKGROUND_PRODUCT_IMAGES } from "../../data/productImageFit";

interface Props {
  title: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  description?: string;
  bestFor?: string;
  features?: string[];
  supplier?: string;
  moq?: string;
  priceNote?: string;
  affiliateUrl: string;
  buttonText?: string;
}

const {
  title,
  label,
  image,
  imageAlt = "",
  description,
  features = [],
  moq,
  affiliateUrl,
  buttonText = "Check Product Route on Alibaba",
} = Astro.props;

// The Alibaba listing id is already in the affiliate URL and is the one piece of
// information a buyer needs to find the exact listing, so surface it first.
const productId = affiliateUrl.match(/productId=(\d+)/)?.[1];

const facts = [
  productId ? `Product ID: ${productId}` : null,
  label ? `Role: ${label}` : null,
  ...features,
  moq ? `MOQ: ${moq}` : null,
].filter((fact): fact is string => Boolean(fact));

// A workspace photo fills the column by cropping. A catalogue shot on a plain
// light background would lose the product's edges that way, so it is fitted
// whole — the column behind it is white, the same as the photo's own
// background, so there is still no gap above or below. See
// src/data/productImageFit.ts for which images are which.
const fitsWhole = Boolean(image && WHITE_BACKGROUND_PRODUCT_IMAGES.has(image));
const imageFit = fitsWhole
  ? "h-48 w-full object-contain sm:h-full"
  : "h-48 w-full object-cover sm:h-full";
---

<div class="my-8 overflow-hidden rounded-xl border border-border bg-popover shadow-sm">
  <div class="flex flex-col sm:flex-row">
    {
      image && (
        <div class="flex shrink-0 items-center justify-center bg-white sm:w-64">
          <img
            src={image}
            alt={imageAlt}
            width="440"
            height="330"
            loading="lazy"
            class={imageFit}
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
      <h3 class="text-lg font-semibold leading-snug text-foreground sm:text-xl">{title}</h3>

      {description && <p class="text-[15px] leading-6 text-muted-foreground">{description}</p>}

      {
        facts.length > 0 && (
          <ul class="grid gap-2 border-t border-border pt-4 text-[15px] leading-6 text-muted-foreground">
            {facts.map((fact) => (
              <li class="flex items-start gap-2.5">
                <span
                  aria-hidden="true"
                  class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
                />
                {fact}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-auto pt-1">
        <a
          href={affiliateUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          data-placement="inline-card"
          class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-primary px-5 py-2.5 text-sm font-semibold leading-5 text-primary transition-colors hover:bg-primary/5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          {buttonText}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
