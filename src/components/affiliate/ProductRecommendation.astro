---
import { WHITE_BACKGROUND_PRODUCT_IMAGES } from "../../data/productImageFit";
import { PRODUCT_IMAGE_SIZE } from "../../data/productImageSize";

interface Props {
  title: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  description?: string | string[];
  bestFor?: string;
  features?: string[];
  supplier?: string;
  moq?: string;
  priceNote?: string;
  affiliateUrl: string;
  buttonText?: string;
}

const {
  title,
  label,
  image,
  imageAlt = "",
  description,
  features = [],
  moq,
  affiliateUrl,
  buttonText = "Check Product Route on Alibaba",
} = Astro.props;

const paragraphs = typeof description === "string" ? [description] : (description ?? []);

// The listing id is kept in the affiliate URL only. It used to be printed as the
// first fact line on every card, which read as a database field rather than
// something a buyer needs — dropped from the visible card entirely.
const facts = [
  label ? `Role: ${label}` : null,
  ...features,
  moq ? `MOQ: ${moq}` : null,
].filter((fact): fact is string => Boolean(fact));

// A workspace photo fills the column by cropping. A catalogue shot on a plain
// light background would lose the product's edges that way, so it is fitted
// whole — the column behind it is white, the same as the photo's own
// background, so there is still no gap above or below. See
// src/data/productImageFit.ts for which images are which.
const fitsWhole = Boolean(image && WHITE_BACKGROUND_PRODUCT_IMAGES.has(image));
const imageFit = fitsWhole
  ? "h-48 w-full object-contain sm:h-full"
  : "h-48 w-full object-cover sm:h-full";

// The image is `w-full` with an automatic height, so the browser works out the
// placeholder box from these two attributes before the file arrives. Declaring
// the real dimensions keeps that box the same size as the loaded image —
// otherwise a 700×700 file declared as 440×330 grows by 94px on load and pushes
// the rest of the card down. See src/data/productImageSize.ts.
const [imageWidth, imageHeight] = (image && PRODUCT_IMAGE_SIZE[image]) || [700, 700];
---

<div class="affiliate-product-card my-8 overflow-hidden rounded-xl border border-border bg-popover shadow-sm">
  <div class="flex flex-col sm:flex-row">
    {
      image && (
        <div class="flex shrink-0 items-center justify-center bg-white sm:w-64">
          <img
            src={image}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            loading="lazy"
            class={imageFit}
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
      <h3 class="text-lg font-semibold leading-snug text-foreground sm:text-xl">{title}</h3>

      {paragraphs.length > 0 && (
        <div class="flex flex-col gap-2">
          {paragraphs.map((paragraph) => (
            <p class="text-[15px] leading-6 text-muted-foreground">{paragraph}</p>
          ))}
        </div>
      )}

      {
        facts.length > 0 && (
          <ul class="grid gap-1.5 border-t border-border pt-3 text-[15px] leading-6 text-muted-foreground">
            {facts.map((fact) => (
              <li class="flex items-start gap-2.5">
                <span
                  aria-hidden="true"
                  class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
                />
                {fact}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-auto pt-1">
        <a
          href={affiliateUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          data-placement="inline-card"
          class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-primary px-5 py-2.5 text-sm font-semibold leading-5 text-primary transition-colors hover:bg-primary/5 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          {buttonText}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
