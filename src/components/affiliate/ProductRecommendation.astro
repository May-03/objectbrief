---
interface Props {
  title: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  description?: string;
  bestFor?: string;
  features?: string[];
  supplier?: string;
  moq?: string;
  priceNote?: string;
  affiliateUrl: string;
  buttonText?: string;
}

const {
  title,
  label = "Recommended Option",
  image,
  imageAlt = "",
  description,
  bestFor,
  features = [],
  supplier,
  moq,
  priceNote,
  affiliateUrl,
  buttonText = "View on Alibaba",
} = Astro.props;
---

<div
  class:list={[
    "relative isolate my-8 min-h-[20rem] overflow-hidden rounded-md border border-[#d4838a]/40 shadow-sm",
    image && "text-primary-foreground",
    !image && "bg-gradient-to-br from-[#fff8f3] via-[#fff1ee] to-[#ffe6d1] text-foreground",
  ]}
>
  {
    image && (
      <>
        <img
          src={image}
          alt={imageAlt}
          width="1200"
          height="800"
          loading="lazy"
          class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-10 bg-[#7a4a3a]/25 sm:bg-gradient-to-r sm:from-[#4b2a22]/68 sm:via-[#9d5c4b]/20 sm:to-transparent"
        />
      </>
    )
  }
  <div class:list={[
    "relative z-10 flex min-h-[20rem] flex-col justify-between p-5 sm:min-h-[20rem] sm:p-6",
    image ? "max-w-3xl sm:max-w-[68%]" : "max-w-3xl",
  ]}>
    <div>
      <div class:list={[
        "text-xs font-medium uppercase tracking-[0.16em]",
        image ? "text-primary-foreground/75" : "text-muted-foreground",
      ]}>{label}</div>
      <h3 class="mt-2 font-serif text-xl font-semibold leading-snug sm:text-2xl">{title}</h3>
      {description && (
        <p class:list={[
          "mt-3 line-clamp-3 max-w-2xl text-sm leading-5",
          image ? "text-primary-foreground/85" : "text-muted-foreground",
        ]}>{description}</p>
      )}

      {bestFor && (
        <p class="mt-4 line-clamp-2 text-sm leading-5">
          <span class="font-medium">Best for: </span>
          <span class:list={[image ? "text-primary-foreground/80" : "text-muted-foreground"]}>{bestFor}</span>
        </p>
      )}

      {
        features.length > 0 && (
          <ul class:list={[
            "mt-4 grid gap-1.5 text-sm leading-5",
            image ? "text-primary-foreground/85" : "text-muted-foreground",
          ]}>
            {features.map((feature) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class:list={[
                  "mt-2 h-1.5 w-1.5 shrink-0 rounded-full",
                  image ? "bg-primary-foreground/80" : "bg-primary",
                ]} />
                {feature}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div>
      <dl class:list={[
        "mt-4 grid gap-2 border-t pt-3 text-sm sm:grid-cols-3 sm:gap-3",
        image ? "border-primary-foreground/25" : "border-card-border/70",
      ]}>
      {supplier && (
        <div>
          <dt class:list={[
            "text-xs uppercase tracking-wider",
            image ? "text-primary-foreground/65" : "text-muted-foreground",
          ]}>Supplier</dt>
          <dd>{supplier}</dd>
        </div>
      )}
      {moq && (
        <div>
          <dt class:list={[
            "text-xs uppercase tracking-wider",
            image ? "text-primary-foreground/65" : "text-muted-foreground",
          ]}>MOQ</dt>
          <dd>{moq}</dd>
        </div>
      )}
      {priceNote && (
        <div>
          <dt class:list={[
            "text-xs uppercase tracking-wider",
            image ? "text-primary-foreground/65" : "text-muted-foreground",
          ]}>Price</dt>
          <dd>{priceNote}</dd>
        </div>
      )}
      </dl>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <span class:list={[
          "text-xs",
          image ? "text-primary-foreground/65" : "text-muted-foreground",
        ]}>Supplier listing · Verify current terms</span>
        <a
          href={affiliateUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          data-placement="inline-card"
          class:list={[
            "inline-flex min-h-10 items-center gap-2 rounded-sm px-4 py-2 text-sm font-medium transition-colors",
            image
              ? "bg-card text-foreground hover:bg-card/90"
              : "bg-[#c4626c] text-white hover:bg-[#aa4f5a]",
          ]}
        >
          {buttonText} <span aria-hidden="true" class="text-base">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>
