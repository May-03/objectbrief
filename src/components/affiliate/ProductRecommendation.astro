---
import { PRODUCT_IMAGE_SIZE } from "../../data/productImageSize";

interface Props {
  title: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  description?: string | string[];
  bestFor?: string;
  features?: string[];
  supplier?: string;
  moq?: string;
  priceNote?: string;
  affiliateUrl: string;
  buttonText?: string;
}

const {
  title,
  label,
  image,
  imageAlt = "",
  description,
  features = [],
  moq,
  affiliateUrl,
  buttonText = "Check Product Route on Alibaba",
} = Astro.props;

const paragraphs = typeof description === "string" ? [description] : (description ?? []);

// The card is a scan-and-click element, so the blurb is cut at a sentence end
// rather than left to CSS: a line clamp stopped mid-word ("...sold in 250-piece
// packs. Th…") and read as a layout bug. Whole sentences are kept until the
// first one or two fill the space, and the full text stays in the page for
// search engines.
const BLURB_LIMIT = 125;
const HARD_LIMIT = 150;
function shorten(text: string): string {
  if (text.length <= BLURB_LIMIT) return text;
  const sentences = text.match(/[^.!?]+[.!?]+[")\]]?/g) ?? [text];
  let kept = "";
  for (const sentence of sentences) {
    if (kept && (kept + sentence).length > BLURB_LIMIT) break;
    kept += sentence;
  }
  kept = kept.trim();
  if (kept.length === 0) kept = text;
  // Some blurbs are one very long sentence; cut those at a word boundary near
  // the limit rather than letting one card run to four lines.
  if (kept.length > HARD_LIMIT) {
    const cut = kept.slice(0, HARD_LIMIT);
    const space = cut.lastIndexOf(" ");
    kept = (space > HARD_LIMIT * 0.6 ? cut.slice(0, space) : cut).replace(/[,;:]$/, "") + "…";
  }
  return kept;
}

// The listing id is kept in the affiliate URL only. It used to be printed as the
// first fact line on every card, which read as a database field rather than
// something a buyer needs — dropped from the visible card entirely.
const facts = [
  label ? `Role: ${label}` : null,
  ...features,
  moq ? `MOQ: ${moq}` : null,
].filter((fact): fact is string => Boolean(fact));

// Product photos are square, so the image is kept square inside the column
// instead of being stretched down its full height: cover-filling a tall column
// zoomed the photo until the product was cut off at the sides, and containing
// it in the same box shrank the product to a thumbnail with bands of white.
const imageFit = "product-image object-cover";

// The image is `w-full` with an automatic height, so the browser works out the
// placeholder box from these two attributes before the file arrives. Declaring
// the real dimensions keeps that box the same size as the loaded image —
// otherwise a 700×700 file declared as 440×330 grows by 94px on load and pushes
// the rest of the card down. See src/data/productImageSize.ts.
const [imageWidth, imageHeight] = (image && PRODUCT_IMAGE_SIZE[image]) || [700, 700];
---

<div class="affiliate-product-card my-6 overflow-hidden rounded-xl border border-border bg-popover shadow-sm transition-shadow hover:shadow-md">
  <div class="flex flex-col sm:flex-row">
    {
      image && (
        <div class="relative flex shrink-0 items-center justify-center overflow-hidden bg-white sm:w-52">
          <img
            src={image}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            loading="lazy"
            class={imageFit}
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col gap-2.5 p-4 sm:p-5">
      <h3 class="text-[17px] font-semibold leading-snug text-foreground sm:text-lg">{title}</h3>

      {paragraphs.length > 0 && (
        <div class="flex flex-col gap-1.5">
          {paragraphs.map((paragraph) => (
            <p class="text-[14px] leading-[1.55] text-muted-foreground">{shorten(paragraph)}</p>
          ))}
        </div>
      )}

      {
        facts.length > 0 && (
          <ul class="grid gap-1 border-t border-border pt-2.5 text-[14px] leading-[1.5] text-muted-foreground">
            {facts.map((fact) => (
              <li class="flex items-start gap-2.5">
                <span
                  aria-hidden="true"
                  class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
                />
                {fact}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-auto pt-1">
        <a
          href={affiliateUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          data-placement="inline-card"
          class="affiliate-cta inline-flex min-h-10 items-center gap-2 rounded-lg bg-primary px-4 py-2 text-[13px] font-semibold leading-5 text-primary-foreground no-underline transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          {buttonText}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .product-image {
    width: 100%;
    height: 10rem;
    aspect-ratio: auto;
  }
  @media (min-width: 640px) {
    .product-image {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }
</style>
