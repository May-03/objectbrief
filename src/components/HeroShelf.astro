---
// Decorative hero illustration: the kinds of goods the guides cover, on a ruler shelf.
// Colours come from the theme tokens, so it follows light and dark mode.
---
<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden w-[340px] shrink-0 lg:block xl:w-[380px]" viewBox="0 0 380 300" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <!-- hang tag -->
  <path d="M300 18 L318 52" stroke="var(--color-foreground)" stroke-width="1.5"/>
  <g transform="rotate(14 318 80)">
    <path d="M300 62 l18 -12 l18 12 v46 h-36 z" fill="var(--amber-soft)" stroke="var(--color-foreground)" stroke-width="2"/>
    <circle cx="318" cy="64" r="3" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5"/>
    <path d="M308 90 l7 7 l13 -15" stroke="var(--color-primary)" stroke-width="3"/>
  </g>
  <!-- mason jar -->
  <rect x="28" y="132" width="96" height="118" rx="12" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
  <rect x="38" y="108" width="76" height="24" rx="3" fill="var(--amber)" stroke="var(--color-foreground)" stroke-width="2"/>
  <path d="M38 116 h76 M38 124 h76" stroke="var(--color-foreground)" stroke-width="1" opacity=".45"/>
  <rect x="32" y="101" width="88" height="42" rx="5" stroke="var(--color-primary)" stroke-width="2" stroke-dasharray="5 4"/>
  <rect x="44" y="172" width="64" height="48" rx="2" fill="var(--amber-soft)" stroke="var(--color-foreground)" stroke-width="1.5"/>
  <path d="M52 186 h48 M52 196 h34 M52 206 h42" stroke="var(--color-foreground)" stroke-width="2" opacity=".55"/>
  <!-- woozy bottle -->
  <path d="M160 96 h20 v30 c0 14 14 18 14 36 v78 a10 10 0 0 1 -10 10 h-28 a10 10 0 0 1 -10 -10 v-78 c0 -18 14 -22 14 -36 z" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
  <rect x="157" y="72" width="26" height="26" rx="3" fill="var(--color-primary)" stroke="var(--color-foreground)" stroke-width="2"/>
  <rect x="146" y="178" width="48" height="50" fill="var(--color-primary)" opacity=".9"/>
  <path d="M154 194 h32 M154 206 h22" stroke="var(--color-card)" stroke-width="2"/>
  <!-- dropper bottle -->
  <rect x="222" y="178" width="54" height="72" rx="8" fill="var(--amber)" stroke="var(--color-foreground)" stroke-width="2"/>
  <rect x="236" y="154" width="26" height="24" rx="2" fill="var(--color-foreground)"/>
  <rect x="241" y="122" width="16" height="34" rx="8" fill="var(--color-foreground)"/>
  <rect x="230" y="200" width="38" height="30" rx="2" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="1.5"/>
  <path d="M237 211 h24 M237 220 h16" stroke="var(--color-foreground)" stroke-width="2" opacity=".55"/>
  <!-- candle tin -->
  <rect x="300" y="210" width="58" height="40" rx="4" fill="var(--color-card)" stroke="var(--color-foreground)" stroke-width="2"/>
  <rect x="296" y="200" width="66" height="12" rx="3" fill="var(--amber-soft)" stroke="var(--color-foreground)" stroke-width="2"/>
  <circle cx="329" cy="231" r="9" stroke="var(--color-primary)" stroke-width="2"/>
  <!-- shelf + ruler -->
  <path d="M8 251 h364" stroke="var(--color-foreground)" stroke-width="2.5"/>
  <path d="M8 260 h364" stroke="var(--color-foreground)" stroke-width="12" stroke-dasharray="1.5 10.5" stroke-linecap="butt" opacity=".5"/>
  <path d="M8 264 h364" stroke="var(--color-foreground)" stroke-width="20" stroke-dasharray="1.5 58.5" stroke-linecap="butt" opacity=".7"/>
