---
import { FORMS } from "../config/theme.config.ts";

const { compact = false } = Astro.props;
const hasNewsletterEndpoint = Boolean(FORMS.newsletter.action);
const newsletterAction = hasNewsletterEndpoint ? FORMS.newsletter.action : "/api/subscribe";
---

{
  compact ? (
    <div>
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Newsletter</div>
      <p class="mt-2 text-sm text-muted-foreground">A short letter, once a fortnight. No noise.</p>
      <form
        action={newsletterAction}
        method="post"
        data-newsletter-form
        class="mt-3 flex gap-2 relative"
      >
        <label for="newsletter-email-compact" class="sr-only">Email address</label>
        <input
          id="newsletter-email-compact"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus:border-primary"
        />
        <button type="submit" class="rounded-md bg-foreground px-3 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90 disabled:cursor-wait disabled:opacity-60">
          Join
        </button>
        <input name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px opacity-0" />
        <p data-newsletter-status class="sr-only" role="status" aria-live="polite"></p>
      </form>
    </div>
  ) : (
    <section data-newsletter-cta class="border-t border-border/60 pt-16 pb-10">
      <div class="mx-auto max-w-2xl px-5 text-center">
        <h2 class="font-serif text-3xl font-semibold sm:text-4xl">A quieter inbox.</h2>
        <p class="mt-3 text-muted-foreground">
          One thoughtful letter every other Sunday &mdash; new essays, things worth reading, and the occasional photograph.
        </p>
        <form
          action={newsletterAction}
          method="post"
          data-newsletter-form
          class="mx-auto mt-6 flex max-w-md flex-col gap-2 sm:flex-row relative"
        >
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="min-w-0 flex-1 rounded-md border border-input bg-background px-4 py-3 text-sm outline-none focus:border-primary"
          />
          <button type="submit" class="rounded-md bg-foreground px-5 py-3 text-sm font-medium text-background transition-opacity hover:opacity-90 disabled:cursor-wait disabled:opacity-60">
            Subscribe
          </button>
          <input name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px opacity-0" />
          <p data-newsletter-status class="min-h-[18px] text-xs text-muted-foreground w-full" role="status" aria-live="polite"></p>
        </form>
        <p class="mt-3 text-xs text-muted-foreground">Free. Unsubscribe in one click.</p>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector('button[type="submit"]');
      const status = form.querySelector('[data-newsletter-status]');
      const emailInput = form.querySelector('input[name="email"]');
      const honeypot = form.querySelector('input[name="company"]');

      if (!submitButton || !status || !emailInput) return;
      if (honeypot && honeypot.value) return;

      submitButton.disabled = true;
      status.textContent = 'Submitting…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: emailInput.value.trim() }),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) throw new Error(result.message || 'Unable to subscribe right now.');
        status.textContent = result.message || 'Thanks — you’re on the list.';
        emailInput.value = '';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Unable to subscribe right now.';
      } finally {
        submitButton.disabled = false;
      }
    });
  });
</script>
